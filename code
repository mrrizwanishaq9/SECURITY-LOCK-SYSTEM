LOCKOUT_SECONDS = 30

DATA_FILE = "/content/security_v23_data.json"
HISTORY_FILE = "/content/security_v23_history.csv"

# -----------------------------
# DEFAULT DATA
# -----------------------------
DEFAULT_DATA = {
    "pin_hash": "",
    "pattern": [],
    "fingerprint_enabled": True,
    "failed_attempts": 0,
    "total_attempts": 0,
    "successful_unlocks": 0,
    "lockout_until": 0,
    "created": datetime.now().isoformat()
}

# -----------------------------
# LOAD / SAVE
# -----------------------------
def load_data():
    if os.path.exists(DATA_FILE):
        try:
            with open(DATA_FILE, "r", encoding="utf-8") as f:
                data = json.load(f)

            for k, v in DEFAULT_DATA.items():
                if k not in data:
                    data[k] = v

            return data
        except:
            pass

    return DEFAULT_DATA.copy()


data = load_data()


def save_data():
    with open(DATA_FILE, "w", encoding="utf-8") as f:
        json.dump(data, f, indent=4)


# -----------------------------
# HISTORY
# -----------------------------
if not os.path.exists(HISTORY_FILE):
    with open(HISTORY_FILE, "w", newline="", encoding="utf-8") as f:
        writer = csv.writer(f)
        writer.writerow([
            "Timestamp",
            "Method",
            "Status",
            "Details"
        ])


def add_history(method, status, details=""):
    timestamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S")

    with open(HISTORY_FILE, "a", newline="", encoding="utf-8") as f:
        writer = csv.writer(f)
        writer.writerow([
            timestamp,
            method,
            status,
            details
        ])


# -----------------------------
# SECURITY FUNCTIONS
# -----------------------------
def hash_pin(pin):
    return hashlib.sha256(pin.encode("utf-8")).hexdigest()


def valid_pin(pin):
    return pin.isdigit() and 4 <= len(pin) <= 8


def is_locked():
    return time.time() < data.get("lockout_until", 0)


def remaining_lockout():
    return max(
        0,
        int(data.get("lockout_until", 0) - time.time())
    )


def register_failed_attempt(method):
    data["failed_attempts"] += 1
    data["total_attempts"] += 1

    if data["failed_attempts"] >= MAX_ATTEMPTS:
        data["lockout_until"] = time.time() + LOCKOUT_SECONDS
        add_history(
            method,
            "LOCKOUT",
            f"{MAX_ATTEMPTS} failed attempts"
        )
    else:
        add_history(
            method,
            "FAILED",
            f"Attempt {data['failed_attempts']}/{MAX_ATTEMPTS}"
        )

    save_data()


def successful_login(method):
    data["failed_attempts"] = 0
    data["lockout_until"] = 0
    data["total_attempts"] += 1
    data["successful_unlocks"] += 1

    add_history(
        method,
        "SUCCESS",
        "Authentication successful"
    )

    save_data()


