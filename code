pin_input = widgets.Password(
    description="PIN:",
    placeholder="4–8 digits"
)

pin_button = widgets.Button(
    description="🔓 Verify PIN",
    button_style="success"
)


def verify_pin(_):

    if is_locked():
        show_status(
            f"System locked. Wait {remaining_lockout()} seconds.",
            "warning"
        )
        return

    pin = pin_input.value.strip()

    if not valid_pin(pin):
        show_status(
            "PIN must contain 4–8 digits.",
            "error"
        )
        return

    # No PIN configured
    if not data["pin_hash"]:
        data["pin_hash"] = hash_pin(pin)
        save_data()

        successful_login("PIN SETUP")

        show_status(
            "PIN created successfully and stored as SHA-256 hash.",
            "success"
        )

    else:

        if secrets.compare_digest(
            hash_pin(pin),
            data["pin_hash"]
        ):
            successful_login("PIN")

            show_status(
                "PIN authentication successful.",
                "success"
            )

        else:
            register_failed_attempt("PIN")

            show_status(
                f"Incorrect PIN. "
                f"{MAX_ATTEMPTS - data['failed_attempts']} attempts remaining.",
                "error"
            )

    pin_input.value = ""
    refresh_dashboard()


pin_button.on_click(verify_pin)


