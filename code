# -----------------------------
converter_type = widgets.Dropdown(
    options=[
        "Length",
        "Weight",
        "Temperature",
        "Data"
    ],
    description="Type:"
)

converter_value = widgets.FloatText(
    description="Value:"
)

converter_from = widgets.Dropdown(
    options=["Meter", "Kilometer", "Centimeter", "Foot"],
    description="From:"
)

converter_to = widgets.Dropdown(
    options=["Meter", "Kilometer", "Centimeter", "Foot"],
    description="To:"
)

convert_button = widgets.Button(
    description="📏 Convert",
    button_style="info"
)

converter_output = widgets.Output()


def update_units(change=None):

    typ = converter_type.value

    units = {

        "Length": [
            "Meter",
            "Kilometer",
            "Centimeter",
            "Foot"
        ],

        "Weight": [
            "Kilogram",
            "Gram",
            "Pound"
        ],

        "Temperature": [
            "Celsius",
            "Fahrenheit",
            "Kelvin"
        ],

        "Data": [
            "Byte",
            "KB",
            "MB",
            "GB"
        ]
    }

    converter_from.options = units[typ]
    converter_to.options = units[typ]


converter_type.observe(update_units, names="value")


def convert_units(_):

    typ = converter_type.value
    value = converter_value.value
    source = converter_from.value
    target = converter_to.value

    try:

        # Length -> meters
        if typ == "Length":

            factors = {
                "Meter": 1,
                "Kilometer": 1000,
                "Centimeter": 0.01,
                "Foot": 0.3048
            }

            result = value * factors[source] / factors[target]

        # Weight -> grams
        elif typ == "Weight":

            factors = {
                "Kilogram": 1000,
                "Gram": 1,
                "Pound": 453.59237
            }

            result = value * factors[source] / factors[target]

        # Temperature
        elif typ == "Temperature":

            if source == "Celsius":
                c = value
            elif source == "Fahrenheit":
                c = (value - 32) * 5 / 9
            else:
                c = value - 273.15

            if target == "Celsius":
                result = c
            elif target == "Fahrenheit":
                result = c * 9 / 5 + 32
            else:
                result = c + 273.15

        # Data
        else:

            factors = {
                "Byte": 1,
                "KB": 1024,
                "MB": 1024 ** 2,
                "GB": 1024 ** 3
            }

            result = value * factors[source] / factors[target]

        with converter_output:
            clear_output()
            print(
                f"📏 Result: {value:g} {source} = "
                f"{result:.6g} {target}"
            )

        add_history(
            "CONVERTER",
            "SUCCESS",
            f"{value} {source} -> {result:.6g} {target}"
        )

    except Exception as e:

        with converter_output:
            clear_output()
            print("❌ Conversion error:", e)


convert_button.on_click(convert_units)


